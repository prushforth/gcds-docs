{% set components = ["components", locale | upper] | join %}
{% set mapComponents = ["mapComponents", locale | upper] | join %}
{% set pageTemplates = ["pageTemplates", locale | upper] | join %}
{% set shortcuts = ["shortcuts", locale | upper] | join %}

{% set navPages = collections.all | eleventyNavigation %}
{% set componentPages = collections.all | eleventyNavigation(components) | sortAlpha %}
{% set mapComponentPages = collections.all | eleventyNavigation(mapComponents) | sortCollection %}
{% set templatePages = collections.all | eleventyNavigation(pageTemplates) | sortAlpha %}
{% set shortcutsPages = collections.all | eleventyNavigation(shortcuts) %}

{% macro isCurrent(url) -%}
  {% if page.url == url %}current{% endif %}
{%- endmacro %}

{% macro isNavGroupOpen(url) -%}
  {% if url == links.mapComponents and (page.url | contains('/map') or page.url | contains('/composants-de-carte')) %}
    open
  {% elif page.url | contains(url) and not (url == links.components and (page.url | contains('/map') or page.url | contains('/composants-de-carte'))) %}
    open
  {% endif %}
{%- endmacro %}

{% macro isCSSShortcutGroupOpen(children, url) -%}
  {% for child in children %}
    {% if page.url | contains(child.url) %}
      open
    {% endif %}
  {% endfor %}
{%- endmacro %}

{% macro renderComponentListItem(entry) -%}
{% if entry.state === 'published' %}
  {# Simple link to component page - tabs are on the page itself #}
  <gcds-nav-link
    href="{{ entry.url | url }}"
    {{ isCurrent(entry.url) }}
  >
    {{ entry.title }}
  </gcds-nav-link>
{% endif %}
{%- endmacro %}

{% macro renderMapComponentListItem(entry) -%}
{% if entry.state === 'published' %}
  {# Simple link for map components #}
  <gcds-nav-link
    href="{{ entry.url | url }}"
    {{ isCurrent(entry.url) }}
  >
    {{ entry.title }}
  </gcds-nav-link>
{% endif %}
{%- endmacro %}

{% macro renderNavListItem(entry) -%}
{% if not entry.hideMain %}
  {% if entry.url %}
    <gcds-nav-link
      href="{{ entry.url | url }}"
      {{ isCurrent(entry.url) }}
    >
      {{ entry.title }}
    </gcds-nav-link>
  {% endif %}
{% endif %}
{%- endmacro %}

{% macro renderCSSShortcutItem(entry) -%}
{% if not entry.hideMain %}
  {% if not entry.url and entry.children %}
    <gcds-nav-group
      menu-label="{{ entry.title }}"
      open-trigger="{{ entry.title }}"
      {{ isCSSShortcutGroupOpen(entry.children | sortAlpha, entry.url) }}
     >
      {%- for child in entry.children %}
        {%- if child.locale == locale %}{{ renderNavListItem(child) }}{% endif -%}
      {%- endfor -%}
    </gcds-nav-group>
  {% else %}
      <gcds-nav-link
        href="{{ entry.url | url }}"
        {{ isCurrent(entry.url) }}
      >
        {{ entry.title }}
      </gcds-nav-link>
  {% endif %}
{% endif %}
{%- endmacro %}

<gcds-side-nav label="{{ nav[locale].label }}" class="side-nav lg:position-sticky box-border overflow-x-visible align-self-start px-75">
  <gcds-nav-link slot="home" href="{{ links.home }}">{{ nav[locale].home }}</gcds-nav-link>
  <gcds-nav-link href="{{ links.startToUse }}" {{ isCurrent(links.startToUse) }}>{{ nav[locale].starttouse }}</gcds-nav-link>

  {# Map Components #}
  
  <gcds-nav-group
    menu-label="{{ nav[locale].mapcomponents }}"
    open-trigger="{{ nav[locale].mapcomponents }}"
    {{ isNavGroupOpen(links.mapComponents) }}
  >
    {%- for entry in mapComponentPages %}
      {%- if entry.locale == locale %}{{ renderMapComponentListItem(entry) }}{% endif -%}
    {%- endfor -%}
  </gcds-nav-group>

  {# Contact #}

  <gcds-nav-link href="{{ links.contact }}" {{ isCurrent(links.contact) }}>{{ nav[locale].contactus }}</gcds-nav-link>
</gcds-side-nav>